# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Password for VS Code SSH access (root@localhost:2222)
# Change this — do not use the default in any shared or exposed environment.
SSH_PASSWORD=changeme

# Optional: name your sandbox (default: claude-sandbox)
# SANDBOX_NAME=claude-sandbox

# ── AWS ───────────────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── GitHub ────────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=

# ── Add your own credentials below ───────────────────────────────────────────
