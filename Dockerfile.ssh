FROM node:20-bookworm-slim

# ── Base tools ────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    curl \
    git \
    python3 \
    python3-pip \
    ripgrep \
    jq \
    unzip \
    awscli \
    && rm -rf /var/lib/apt/lists/* \
    # openssh-server creates host keys on install; the entrypoint makes this container's own in /etc/ssh/keys
    && rm -f /etc/ssh/ssh_host_*

# ── Claude Code ───────────────────────────────────────────────────────────────
RUN npm install -g @anthropic-ai/claude-code

# ── Additional software ───────────────────────────────────────────────────────
# Uncomment or add packages you want available in the VS Code terminal.

# Global npm packages:
# RUN npm install -g typescript ts-node
#
# Python packages:
# RUN pip3 install --no-cache-dir httpie
#
# ─────────────────────────────────────────────────────────────────────────────

# The root password is set at container start from SSH_PASSWORD (see entrypoint.sh),
# so it is not stored in the image or its build history
RUN mkdir /var/run/sshd

RUN printf '%s\n' \
    'Port 2222' \
    'PermitRootLogin yes' \
    'PasswordAuthentication yes' \
    'AllowTcpForwarding yes' \
    'X11Forwarding no' \
    'PrintMotd no' \
    'Subsystem sftp /usr/lib/openssh/sftp-server' \
    'HostKey /etc/ssh/keys/ssh_host_rsa_key' \
    'HostKey /etc/ssh/keys/ssh_host_ecdsa_key' \
    'HostKey /etc/ssh/keys/ssh_host_ed25519_key' \
    > /etc/ssh/sshd_config

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 2222
HEALTHCHECK --interval=30s --timeout=3s CMD bash -c "</dev/tcp/127.0.0.1/2222" || exit 1
CMD ["/entrypoint.sh"]
