# Node 24 is the current LTS (Node 20 reached end of life in April 2026)
FROM node:24-bookworm-slim

# ── Base tools ────────────────────────────────────────────────────────────────
# The upgrade picks up Debian security fixes the base image doesn't have yet
# hadolint ignore=DL3005
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    openssh-server \
    curl \
    git \
    python3 \
    python3-pip \
    ripgrep \
    jq \
    unzip \
    awscli \
    && rm -rf /var/lib/apt/lists/* \
    # openssh-server creates host keys on install; the entrypoint makes this container's own in /etc/ssh/keys
    && rm -f /etc/ssh/ssh_host_*

# ── Claude Code ───────────────────────────────────────────────────────────────
# Newer npm first: the one bundled with Node ships outdated tar and brace-expansion
RUN npm install -g npm@latest @anthropic-ai/claude-code && npm cache clean --force
# npm still bundles undici 6.29.0 (CVE-2026-109383 and two more HIGH); swap in the 6.29.1 patch release.
# Drop this step once npm ships undici >= 6.29.1.
RUN cd /tmp && npm pack --silent undici@6.29.1 \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/undici \
    && mkdir /usr/local/lib/node_modules/npm/node_modules/undici \
    && tar -xzf undici-6.29.1.tgz --strip-components=1 -C /usr/local/lib/node_modules/npm/node_modules/undici \
    && rm undici-6.29.1.tgz && npm --version >/dev/null && npm cache clean --force

# ── Additional software ───────────────────────────────────────────────────────
# Uncomment or add packages you want available in the VS Code terminal.

# Global npm packages:
# RUN npm install -g typescript ts-node
#
# Python packages:
# RUN pip3 install --no-cache-dir httpie
#
# ─────────────────────────────────────────────────────────────────────────────

# The root password is set at container start from SSH_PASSWORD (see entrypoint.sh),
# so it is not stored in the image or its build history
RUN mkdir /var/run/sshd

RUN printf '%s\n' \
    'Port 2222' \
    'PermitRootLogin yes' \
    'PasswordAuthentication yes' \
    'AllowTcpForwarding yes' \
    'X11Forwarding no' \
    'PrintMotd no' \
    'Subsystem sftp /usr/lib/openssh/sftp-server' \
    'HostKey /etc/ssh/keys/ssh_host_rsa_key' \
    'HostKey /etc/ssh/keys/ssh_host_ecdsa_key' \
    'HostKey /etc/ssh/keys/ssh_host_ed25519_key' \
    > /etc/ssh/sshd_config

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 2222
HEALTHCHECK --interval=30s --timeout=3s CMD bash -c "</dev/tcp/127.0.0.1/2222" || exit 1
CMD ["/entrypoint.sh"]
